# VerifiedPropertiesKE environment template. Placeholders only: never commit real values.
# Copy to .env.local for development; set production values in the hosting dashboard.
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is server-only.
# Empty values are treated as unset. Only DATABASE_URL is required to run the app today;
# each slice documents the variables it starts to need.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Neon Postgres (S0) ---
# Use the Frankfurt project (aws-eu-central-1): "dev" branch here, "test" branch below.
# Pooled connection string (host contains "-pooler"): used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string: used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=
# Direct connection string of a dedicated Neon "test" branch: integration tests only.
# Never point this at production; tests write and roll back data.
TEST_DATABASE_URL=
# Operator only: direct connection string of the Neon production branch, for one-off
# `node --env-file` checks against the live site. Keep it in .env.local, never in Vercel.
PROD_DATABASE_URL_UNPOOLED=

# --- Auth: Better Auth (S1) ---
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Object storage: Neon Object Storage, S3-compatible (S4) ---
# Leave these empty in development to use the local-disk store under .data/storage/.
# Production refuses photo uploads unless every one except the region is set.
# Neon: the branch storage endpoint, e.g. https://br-xxx.storage.c-7.eu-central-1.aws.neon.tech
# (R2 also works: https://<account>.r2.cloudflarestorage.com with region auto).
STORAGE_S3_ENDPOINT=
# eu-central-1 for the Frankfurt project; defaults to auto.
STORAGE_S3_REGION=
# Neon credential on that branch with storage:read and storage:write. Never log or share it.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public-read bucket: processed listing photos (WebP variants only).
STORAGE_PUBLIC_BUCKET=
# Private bucket: temporary uploads and, later, verification documents. Never served publicly.
STORAGE_PRIVATE_BUCKET=
# Public URL of the public bucket, e.g. <endpoint>/listing-photos
STORAGE_PUBLIC_BASE_URL=

# --- Email: Resend (S1) ---
RESEND_API_KEY=
# e.g. "VerifiedPropertiesKE <no-reply@example.co.ke>"
EMAIL_FROM=

# --- Rate limiting: Upstash Redis (S1) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Background jobs: Upstash QStash (S9) ---
# From the Upstash console > QStash. The app needs both signing keys: /api/jobs/* refuses every
# request (503) until they are set, and 401s anything without a valid signature.
# QSTASH_TOKEN is only for `npm run jobs:schedule`. Never log or share any of these.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional region host shown in the console (e.g. https://qstash-eu-central-1.upstash.io).
QSTASH_URL=
# Not a stored setting: export JOBS_FAKE_CLOCK_CONFIRM=yes only for one `npm run jobs:run -- <job>
# --now <ISO>` command against a dev or test branch. A fake clock can pause real listings.
# JOBS_FAKE_CLOCK_CONFIRM=
# Not a stored setting either: export SEED_CONFIRM=<endpoint> only for one `npm run db:seed`
# (or `-- --remove`) against a dev branch. <endpoint> is the database host's first label, e.g.
# ep-cool-name-a1b2c3d4; a run without it prints the value. Never seed production.
# SEED_CONFIRM=

# --- M-Pesa Daraja (S5) ---
# Development without Daraja credentials: set only MPESA_CALLBACK_TOKEN and a dev-only simulator
# is used (npm run mpesa:simulate). Production refuses payments unless all four credentials are set.
# sandbox | production
MPESA_ENV=sandbox
# From your app on developer.safaricom.co.ke.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill shortcode (sandbox STK: 174379). Paybill only: the C2B fallback needs one.
MPESA_SHORTCODE=
# Lipa Na M-Pesa Online passkey (sandbox: shown on the Daraja portal's simulator page).
MPESA_PASSKEY=
# Secret path segment for the callback URLs (24+ random characters, e.g. openssl rand -hex 24).
# Callbacks are unsigned; never log or share this value.
MPESA_CALLBACK_TOKEN=
# Public HTTPS base URL Safaricom can reach (e.g. a Vercel preview or a cloudflared/ngrok tunnel).
# Defaults to NEXT_PUBLIC_APP_URL, which is enough for the simulator.
MPESA_CALLBACK_BASE_URL=
# Comma-separated IPv4 CIDRs allowed to call the callbacks. Production defaults to the
# community-documented Safaricom ranges 196.201.212.0/24,196.201.213.0/24,196.201.214.0/24
# (confirm with Safaricom at go-live). Sandbox: enforced only when set.
MPESA_CALLBACK_ALLOWED_IPS=

# --- Card payments: Paystack (S6, optional) ---
# Visa/Mastercard through Paystack's hosted checkout. Empty hides the Card option (M-Pesa only).
# Secret key from Paystack Settings > API Keys & Webhooks: sk_test_... in development,
# sk_live_... in production (a test key is refused in production). Never log or share it.
PAYSTACK_SECRET_KEY=
# Comma-separated IPv4 CIDRs allowed to call /api/payments/card/webhook. With a live key it
# defaults to Paystack's 52.31.139.75,52.49.173.169,52.214.14.220. Test key: enforced only when set.
PAYSTACK_WEBHOOK_ALLOWED_IPS=

# --- SMS: Africa's Talking (S9, optional) ---
# Renewal reminders by SMS. Empty: development prints SMS to the console; production skips them.
# AT_USERNAME=sandbox uses the Africa's Talking sandbox (see its simulator). AT_SENDER_ID is your
# approved alphanumeric sender name, if any. Never log or share AT_API_KEY.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Maps (Phase 3) ---
# Restricted public token (limited by allowed origins and APIs).
NEXT_PUBLIC_MAP_TOKEN=
# Provider test (S18) and server-side geocoding (S19). Server-only, never NEXT_PUBLIC_.
# Google Maps Platform key restricted to: Places API (New), Geocoding API, Maps Static API.
GOOGLE_MAPS_API_KEY=
# Mapbox access token (a default public pk. token is enough for geocoding and static images).
MAPBOX_ACCESS_TOKEN=
